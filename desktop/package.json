{
  "name": "albok-desktop",
  "productName": "Albok",
  "version": "0.1.0",
  "description": "Albok kiosk shell for school PCs",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test web-tools.test.js",
    "dev": "cross-env ALBOK_URL=http://localhost:8081 ALBOK_KIOSK=false ALBOK_AUTH_ORIGINS=http://localhost:8765 electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.albok.app",
    "productName": "Albok",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "web-tools.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../frontend/assets/images/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
