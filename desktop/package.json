{
  "name": "albok-desktop",
  "productName": "Albok",
  "version": "0.1.0",
  "description": "Albok - follow your class book and keep notes by subject",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env ALBOK_DEV_SERVER_URL=http://localhost:8081 electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.albok.app",
    "productName": "Albok",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "web"
      },
      {
        "from": "../backend/dist/albok-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../frontend/assets/images/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
