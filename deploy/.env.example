# --- Required ---------------------------------------------------------------------------------
# Public address of Albok (DNS must point here; ports 80 and 443 open to the internet).
ALBOK_DOMAIN=albok.skola.hr
# Long random values, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
ALBOK_SESSION_SECRET=
# Where release images are published, and which version to run.
# Updating: change ALBOK_VERSION, then `docker compose pull && docker compose up -d`.
ALBOK_REGISTRY=ghcr.io/albok
ALBOK_VERSION=latest

# --- School ----------------------------------------------------------------------------------------
ALBOK_SCHOOL_NAME=Gimnazija ...
# The school's published GDPR privacy policy (required by AAI@EduHr).
ALBOK_PRIVACY_URL=https://www.skola.hr/privatnost
# AAI usernames that are always administrators (the first admin signs in with this).
ALBOK_ADMINS=ime.prezime@skole.hr
ALBOK_TIMEZONE=Europe/Zagreb

# --- AAI@EduHr (OpenID Connect) ------------------------------------------------------------------
# From the resource registration at registar.aaiedu.hr (see docs/deployment.md). Register the redirect URI
# https://<ALBOK_DOMAIN>/auth/callback and the post-logout URI https://<ALBOK_DOMAIN>/login.
# Use the issuer the registry shows (AAI@EduHr Lab while the resource is a Test resource).
ALBOK_OIDC_ISSUER=
ALBOK_OIDC_CLIENT_ID=
ALBOK_OIDC_CLIENT_SECRET=
# client_secret_basic or client_secret_post, whichever the registry lists.
ALBOK_OIDC_TOKEN_AUTH=client_secret_basic
# Value of `o` or `hrEduPersonHomeOrg` for this school; empty disables the check (see docs/deployment.md).
ALBOK_SCHOOL_ORG=
# Leave as is unless AAI@EduHr rejects it (shared PCs depend on it).
ALBOK_OIDC_PROMPT=login

# --- Email (school SMTP relay) ---------------------------------------------------------------------
ALBOK_SMTP_HOST=
ALBOK_SMTP_PORT=587
# starttls, ssl or none
ALBOK_SMTP_SECURITY=starttls
ALBOK_SMTP_USER=
ALBOK_SMTP_PASSWORD=
ALBOK_MAIL_FROM=Albok <albok@skola.hr>

# --- Optional --------------------------------------------------------------------------------------
# Where backups are written on the host; IT copies this folder off the server.
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
ALBOK_STUDENT_IDLE_MINUTES=10
