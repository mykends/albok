# ALBOK_SITE is the public address, e.g. albok.skola.hr (automatic HTTPS from Let's Encrypt).
# To use a certificate provided by the school, put a `tls /certs/fullchain.pem /certs/privkey.pem` line in
# deploy/caddy/extra/tls.caddy and mount the certificates (see docker-compose.yml).
{$ALBOK_SITE} {
	import /etc/caddy/extra/*.caddy

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# pdf.js needs WebAssembly (JBIG2/JPEG 2000 decoders) and blob: workers; react-native-web injects styles.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}

	@backend path /api/* /auth/*
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		@immutable path /_expo/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
